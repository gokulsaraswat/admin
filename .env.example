# Names only. Real values go in .env.local (git-ignored) and Vercel env vars. Never commit values.

# GitHub token, classic, read:packages ONLY. Used by .npmrc to install @gokulsaraswat/* (no quotes around the value).
NODE_AUTH_TOKEN=

# Supabase (new platform project `gokul-platform`): Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never import in client code, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
